{
  "name": "chat-application",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*",
    "#config/*": "./config/*",
    "#DB/*": "./DB/*",
    "#logs/*": "./logs/*",
    "#utils/*": "./src/utils/*",
    "k8s/*": "./k8s/*",
    "docker/*": "./Docker/*",
    "nginx/*": "./nginx/*",
    "winston/*": "./winston/*"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": " cross-env NODE_ENV=production nest start",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "dev:docker": "cross-env NODE_ENV=development_docker nest start --watch",
    "start:debug": "NEST_DEBUG=true nest start --debug --watch",
    "start:prod": "node dist/main",
    "deploy": "sh ./deploy.sh",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_ENV=test jest --ci",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --ci --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "migration:generate:dev": "cross-env NODE_ENV=development typeorm-ts-node-commonjs migration:generate -d ./DB/data-source.ts",
    "migration:run:dev": "cross-env NODE_ENV=development typeorm-ts-node-commonjs migration:run -d ./DB/data-source.ts",
    "migration:revert:dev": "cross-env NODE_ENV=development typeorm-ts-node-commonjs migration:revert -d ./DB/data-source.ts",
    "migration:run:prod": "cross-env NODE_ENV=production typeorm-ts-node-commonjs migration:run -d ./DB/data-source.ts",
    "migration:revert:prod": "cross-env NODE_ENV=production typeorm-ts-node-commonjs migration:revert -d ./DB/data-source.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@keyv/redis": "^5.1.6",
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/apollo": "^14.0.2",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.25",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.25",
    "@simplewebauthn/server": "^13.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth2": "^0.1.10",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "csrf-csrf": "^4.0.3",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "keyv": "^5.6.0",
    "morgan": "^1.12.1",
    "nest-winston": "^2.0.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth2": "^0.2.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/k6": "^2.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  }
}
